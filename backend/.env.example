# ==============================================================================
# VitalGuard AI - Backend Environment Configuration Example
# ==============================================================================
# Copy this file to .env or configure these variables in your deployment target.
# NEVER commit real credentials or production secrets to source control.

# Database Configuration
# ----------------------
# For local SQLite development (default if unset):
# VITALGUARD_DB_PATH=vitalguard_demo.sqlite3
#
# For PostgreSQL (Render / Supabase / Neon / AWS RDS / local Postgres):
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg://vitalguard_user:change_me_to_a_secure_password@localhost:5432/vitalguard_db

# Authentication / Identity Bootstrap
# -----------------------------------
# Secret key used to sign bearer tokens. Must be at least 32 characters in length.
VITALGUARD_AUTH_SECRET=replace_with_a_random_32_character_or_longer_secret_string

# Operator / Service bootstrap credentials
VITALGUARD_AUTH_USERNAME=demo-operator
VITALGUARD_AUTH_PASSWORD=replace_with_a_secure_demo_operator_password

# CORS Configuration
# ------------------
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://vitalguard-ai-dc.onrender.com
